# Server-side only. Used by next.config.ts rewrites so the browser
# can call same-origin `/api/v1/...` while Next proxies to FastAPI.
# Do not put DATABASE_URL, Supabase service-role keys, or LLM keys here.
BACKEND_URL=http://127.0.0.1:8000

# Public Supabase Auth settings used only for browser social sign-in.
# These are publishable/anon credentials, never service-role credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
