# Supabase Postgres connection (async driver -> use postgresql+asyncpg://)
# Get this from Supabase project settings -> Database -> Connection string
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# Supabase Auth (Phase 2) -- get these from Supabase project settings -> API
# and Settings -> API -> JWT Settings.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Timeout (seconds) for outbound HTTP calls to Supabase Auth. Optional --
# defaults to 10.0 if unset (see app/core/config.py).
HTTP_TIMEOUT_SECONDS=10.0

# LLM Explanation Layer (Phase 15) -- Gemini primary, OpenRouter fallback
# Both API keys default to empty string (not required) — app still runs and
# deterministic analysis persists successfully with neither configured.
# See app/core/config.py and app/services/llm_providers.py for fail-closed behavior.
# Get Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Get OpenRouter API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Timeout (seconds) for outbound HTTP calls to LLM providers. Optional --
# defaults to 30.0 if unset (see app/core/config.py).
LLM_TIMEOUT_SECONDS=30.0

# RxNorm import — bounded-memory batch size (optional, defaults to 500).
# Controls streaming persistence batch size for backend/scripts/import_rxnorm.py.
RXNORM_IMPORT_BATCH_SIZE=500
