# Supabase Postgres connection (async driver -> use postgresql+asyncpg://)
# Get this from Supabase project settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.icwtuhbhdrpjdtoibxxk.supabase.co:5432/postgres

# Supabase Auth (Phase 2) -- get these from Supabase project settings -> API
# and Settings -> API -> JWT Settings.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Timeout (seconds) for outbound HTTP calls to Supabase Auth. Optional --
# defaults to 10.0 if unset (see app/core/config.py).
HTTP_TIMEOUT_SECONDS=10.0
